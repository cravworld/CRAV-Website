# Copy this file to .env.local and replace the placeholder values with real ones.
# Vercel uses the same variable names in Project Settings > Environment Variables.

# Destination inbox for form submissions.
CONTACT_TO=hello@example.com

# Verified sender address in Resend.
CONTACT_FROM=CRAV <hello@example.com>

# Resend API key used by /api/contact.
RESEND_API_KEY=re_placeholder_api_key
